<Window x:Class="ThemeAutomation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Theme Automation"
        Width="1040"
        Height="700"
        MinWidth="960"
        MinHeight="640"
        Background="#F5F7F2"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#182019" />
        <SolidColorBrush x:Key="MutedBrush" Color="#657264" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F5F7F2" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#17201A" />
        <SolidColorBrush x:Key="SidebarNavActiveBrush" Color="#D8F2DC" />
        <SolidColorBrush x:Key="SidebarNavInactiveBrush" Color="#0017201A" />
        <SolidColorBrush x:Key="SidebarNavActiveTextBrush" Color="#174A27" />
        <SolidColorBrush x:Key="SidebarNavMutedTextBrush" Color="#9BB09C" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E7DE" />
        <SolidColorBrush x:Key="GreenBrush" Color="#2F6B4F" />
        <SolidColorBrush x:Key="GreenSoftBrush" Color="#D8F2DC" />
        <SolidColorBrush x:Key="DaySoftBrush" Color="#FFF0C2" />
        <SolidColorBrush x:Key="DayInkBrush" Color="#6F4E00" />
        <SolidColorBrush x:Key="NightSoftBrush" Color="#E7E2FF" />
        <SolidColorBrush x:Key="NightInkBrush" Color="#4E3EB8" />

        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource SidebarNavMutedTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SidebarNavInactiveBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SidebarNavInactiveBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource GreenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#D8DDD5" />
        </Style>

        <Style x:Key="ModernVerticalScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="#EEF3EA" />
            <Setter Property="Foreground" Value="#B6D7BA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Width="8"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{TemplateBinding Foreground}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernVerticalScrollBar}" />

        <Style x:Key="ProfileCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Width" Value="144" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#D8DDD5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar"
                Grid.Column="0"
                Background="{StaticResource SidebarBrush}">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{StaticResource GreenSoftBrush}"
                            VerticalAlignment="Top">
                        <Grid x:Name="CrescentIcon">
                            <Ellipse Width="15" Height="15" Fill="{StaticResource SidebarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="15" Height="15" Fill="{StaticResource GreenSoftBrush}" Margin="9,-3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="WTA" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Theme Auto" FontSize="13" FontWeight="SemiBold" Foreground="#AFC5B1" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Width="120"
                        Height="32"
                        CornerRadius="16"
                        Background="{StaticResource GreenSoftBrush}"
                        HorizontalAlignment="Left"
                        Margin="0,52,0,34">
                    <TextBlock Text="Active"
                               Foreground="#174A27"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="2" Margin="0,118,0,0">
                    <Button x:Name="ProfilesNavButton"
                            Content="Profiles"
                            Click="ProfilesNav_Click"
                            Style="{StaticResource SidebarNavButton}" />
                    <Button x:Name="DiagnosticsNavButton"
                            Content="Diagnostics"
                            Click="DiagnosticsNav_Click"
                            Style="{StaticResource SidebarNavButton}" />
                    <Button x:Name="SchedulerNavButton"
                            Content="Scheduler"
                            Click="SchedulerNav_Click"
                            Style="{StaticResource SidebarNavButton}" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="v2 desktop preview"
                           Foreground="#728774"
                           FontSize="12"
                           FontWeight="Medium" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="132" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceBrush}">
                <Grid Margin="40,28,40,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Windows Theme Automation"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Day, night, and Night Light control from one calm desktop panel."
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="128"
                            Height="40"
                            CornerRadius="8"
                            Background="{StaticResource DaySoftBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#x2600; Day mode"
                                   Foreground="{StaticResource DayInkBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Button Grid.Column="3"
                            Content="Apply now"
                            Width="96"
                            VerticalAlignment="Top"
                            Click="Apply_Click"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="40,28,40,28">
                <Grid x:Name="ProfilesView" Visibility="{Binding ProfilesViewVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="268" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="76" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ProfileCard}">
                        <StackPanel>
                            <TextBlock Text="DAY PROFILE" FontSize="11" FontWeight="Bold" Foreground="#6F8B4E" />
                            <Grid Margin="0,12,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource DaySoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#x2600;"
                                               Foreground="{StaticResource DayInkBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Light theme"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="Start time" FontSize="12" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Text="{Binding DayStartText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,18" />

                            <Grid>
                                <TextBlock Text="Night Light warmth" FontSize="12" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding DayWarmthText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding DayWarmth}"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ProfileCard}">
                        <StackPanel>
                            <TextBlock Text="NIGHT PROFILE" FontSize="11" FontWeight="Bold" Foreground="#7B6AE8" />
                            <Grid Margin="0,12,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource NightSoftBrush}" VerticalAlignment="Center">
                                    <Grid>
                                        <Ellipse Width="15" Height="15" Fill="{StaticResource NightInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Width="15" Height="15" Fill="{StaticResource NightSoftBrush}" Margin="8,-4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Dark theme"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="Start time" FontSize="12" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Text="{Binding NightStartText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,18" />

                            <Grid>
                                <TextBlock Text="Night Light warmth" FontSize="12" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding NightWarmthText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding NightWarmth}"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Background="#EEF3EA"
                            CornerRadius="8"
                            Padding="22,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox Content="Gamma fallback enabled"
                                          IsChecked="{Binding EnableFallbackFilter}"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Used only when native Night Light does not verify."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="24,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Save" Width="74" Margin="0,0,10,0" Click="Save_Click" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Status" Width="78" Click="Status_Click" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="DiagnosticsView" Visibility="{Binding DiagnosticsViewVisibility}">
                    <Border Style="{StaticResource ProfileCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Night Light diagnostics"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding DiagnosticsSummary}"
                                               FontSize="14"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                                <Border Width="120"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="{StaticResource GreenSoftBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DiagnosticsStatus}"
                                               Foreground="#174A27"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="#EEF3EA"
                                    CornerRadius="8"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Configuration"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding ConfigPath}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding LogPath}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="4">
                                <TextBlock Text="Refresh diagnostics when Night Light changes outside the app."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="Refresh"
                                        Width="90"
                                        HorizontalAlignment="Right"
                                        Click="RefreshDiagnostics_Click"
                                        Style="{StaticResource PrimaryButton}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SchedulerView" Visibility="{Binding SchedulerViewVisibility}">
                    <Border Style="{StaticResource ProfileCard}">
                        <ScrollViewer Style="{StaticResource ModernScrollViewer}">
                            <StackPanel x:Name="SchedulerScrollContent"
                                        Margin="0,0,18,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Scheduler"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding SchedulerSummary}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Button Content="Refresh"
                                            Width="90"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Click="RefreshScheduler_Click"
                                            Style="{StaticResource SecondaryButton}" />
                                </Grid>

                                <Border Background="#EEF3EA"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,22,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Active days"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding ActiveDaysSummary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource GreenBrush}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>

                                        <UniformGrid Columns="4" Margin="0,14,0,0">
                                            <CheckBox Content="Monday"
                                                      IsChecked="{Binding MondayActive}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}"
                                                      Margin="0,0,10,10" />
                                            <CheckBox Content="Tuesday"
                                                      IsChecked="{Binding TuesdayActive}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}"
                                                      Margin="0,0,10,10" />
                                            <CheckBox Content="Wednesday"
                                                      IsChecked="{Binding WednesdayActive}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}"
                                                      Margin="0,0,10,10" />
                                            <CheckBox Content="Thursday"
                                                      IsChecked="{Binding ThursdayActive}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}"
                                                      Margin="0,0,10,10" />
                                            <CheckBox Content="Friday"
                                                      IsChecked="{Binding FridayActive}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}"
                                                      Margin="0,0,10,0" />
                                            <CheckBox Content="Saturday"
                                                      IsChecked="{Binding SaturdayActive}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}"
                                                      Margin="0,0,10,0" />
                                            <CheckBox Content="Sunday"
                                                      IsChecked="{Binding SundayActive}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}"
                                                      Margin="0,0,10,0" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <CheckBox Content="Apply on logon"
                                                      IsChecked="{Binding ApplyOnLogon}"
                                                      FontSize="14"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}" />
                                            <CheckBox Content="Catch-up missed switch"
                                                      IsChecked="{Binding CatchUpMissedSwitch}"
                                                      FontSize="14"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource InkBrush}"
                                                      Margin="0,12,0,0" />
                                            <TextBlock Text="Catch-up applies the correct profile after login when a scheduled switch was missed."
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="24,5,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Logon delay"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Text="{Binding LogonDelaySecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="126"
                                                     Margin="0,6,0,0" />
                                            <TextBlock Text="seconds"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#EEF3EA"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Expected triggers"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="Day 07:00  |  Night 19:00  |  Logon after 30 seconds"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SchedulerDetails}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{StaticResource InkBrush}"
                                               Margin="0,16,0,0" />
                                </StackPanel>
                                </Border>

                                <Grid Margin="0,18,0,0">
                                    <TextBlock Text="Install or remove only the tasks managed by this app."
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="Uninstall"
                                                Width="92"
                                                Margin="0,0,10,0"
                                                Click="Uninstall_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button Content="Install"
                                                Width="78"
                                                Click="Install_Click"
                                                Style="{StaticResource PrimaryButton}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="FeedbackOverlay"
              Grid.ColumnSpan="2"
              Background="#99000000"
              Visibility="{Binding AppliedOverlayVisibility}">
            <Border Width="420"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="{StaticResource GreenSoftBrush}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <TextBlock Text="&#x2713;"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding FeedbackTitle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding FeedbackMessage}"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,18" />

                    <Border Background="#EEF3EA"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{Binding FeedbackBadge}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding FeedbackDetails}"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <TextBlock Text="Windows Theme Automation"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="Close"
                                Width="84"
                                HorizontalAlignment="Right"
                                Click="CloseAppliedOverlay_Click"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
